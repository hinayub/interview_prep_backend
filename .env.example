# Copy to frontend/.env. Vite only exposes vars prefixed with VITE_.
# Use 127.0.0.1, not localhost: on Windows `localhost` resolves to ::1 as well as
# 127.0.0.1, browsers try ::1 first, and `manage.py runserver` binds IPv4 only —
# so `localhost` intermittently fails with a bare FETCH_ERROR.
VITE_API_URL=http://127.0.0.1:8000/api
