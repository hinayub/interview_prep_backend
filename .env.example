# Copy to backend/.env and fill in. .env is gitignored; this file is not.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# --- Local LLM (Ollama) ------------------------------------------------------
# Install: https://ollama.com/download/windows   then: ollama pull llama3.2:3b
# llama3.2:3b (~2GB resident) is the default because this machine has 7.4GB RAM
# total; llama3:8b needs ~4.7GB and swaps hard alongside the dev servers. Bump
# this to llama3:8b on a bigger box - nothing else changes.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Hosted LLM (Gemini) ----------------------------------------------------
# Key from https://aistudio.google.com/apikey
# Required for the interview feedback: answer scoring and the final debrief run
# here, not on Ollama. Without a key those steps fail with a message saying so,
# while CV matching and question generation keep working on the local model.
#
# Note on the model: Google retires these, and a retired one is a 404 on every call
# with an otherwise perfectly good key. If scoring fails with "no longer available",
# that is what happened - list what your key can actually reach with
# `client.models.list()` and pin a current one here. `gemini-flash-latest` is the
# alias that tracks whatever the current flash is, at the cost of moving under you.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Multi-model racing -----------------------------------------------------
# True (default) sends every agent prompt to Ollama *and* Gemini at the same time
# and keeps the first valid answer, so a stopped `ollama serve` or a missing key
# above degrades a feature instead of killing it. Each job still declares which
# model it would rather have if both answer - see agents/race.py.
#
# Set False to go back to one model per job (the split described in
# agents/__init__.py). Worth doing if you are metering hosted tokens: racing means
# every question set costs a Gemini call it usually does not end up using.
AGENT_RACE=True

# --- Background agent work --------------------------------------------------
# "thread" runs agent tasks in a daemon thread in the web process - no broker
# needed, which is why it is the default (Redis has no native Windows build).
# "celery" requires a running Redis and a worker started with --pool=solo.
TASK_RUNNER=thread
CELERY_BROKER_URL=redis://localhost:6379/0
